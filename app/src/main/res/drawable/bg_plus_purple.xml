<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_plus_purple.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#EDE7F6" />
            <size android:width="28dp" android:height="28dp" />
        </shape>
    </item>

    <!-- Horizontal bar of "+" -->
    <item
        android:top="12dp"
        android:bottom="12dp"
        android:left="7dp"
        android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#6C63FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Vertical bar of "+" -->
    <item
        android:top="7dp"
        android:bottom="7dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#6C63FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>

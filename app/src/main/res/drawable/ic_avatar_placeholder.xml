<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/ic_avatar_placeholder.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nền tròn xám -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#CCCCCC" />
        </shape>
    </item>

    <!-- Silhouette người (đầu) -->
    <item
        android:top="8dp"
        android:bottom="20dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Silhouette người (thân) -->
    <item
        android:top="28dp"
        android:bottom="4dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="12dp" />
        </shape>
    </item>

</layer-list>

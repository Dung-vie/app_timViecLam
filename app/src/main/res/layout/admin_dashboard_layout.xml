<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingVertical="30dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Trang quản trị"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#18005C"
        android:padding="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HELLO ADMIN"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#18005C"
        android:padding="16dp"/>

    <LinearLayout
        android:id="@+id/layoutRecruiterManager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:background="#F3F3F3"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý nhà tuyển dụng"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duyệt tài khoản nhà tuyển dụng"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutJobManager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:padding="16dp"
        android:background="#F3F3F3"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý bài tuyển dụng"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duyệt bài đăng tuyển dụng"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:padding="7dp"
        android:text="@string/txtLogout"
        android:textAllCaps="false"
        android:textColor="#A32D2D"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#FCEBEB"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_logout"
        app:iconTint="#A32D2D"
        app:iconGravity="textStart"
        app:strokeWidth="0dp" />

</LinearLayout>
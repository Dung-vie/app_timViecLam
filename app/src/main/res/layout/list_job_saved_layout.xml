<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Logo Công ty -->
        <ImageView
            android:id="@+id/ivCompanyLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_launcher_round" /> <!-- Đặt icon mặc định -->

        <!-- Icon More (3 chấm dọc) -->
        <ImageView
            android:id="@+id/ivMoreOptions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_more_vert"
            app:tint="#888899" />

        <!-- Chức danh -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivCompanyLogo"
            android:layout_marginTop="16dp"
            android:text="UI/UX Designer"
            android:textColor="#1A1A2E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Công ty & Địa điểm -->
        <TextView
            android:id="@+id/tvCompanyInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvJobTitle"
            android:layout_marginTop="4dp"
            android:text="Google inc • California, USA"
            android:textColor="#888899"
            android:textSize="12sp" />

        <!-- Vùng Tags (Kỹ năng/Loại hình) -->
        <LinearLayout
            android:id="@+id/llTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCompanyInfo"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_gray"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Design"
                android:textColor="#666680"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_gray"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Full time"
                android:textColor="#666680"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_gray"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Senior designer"
                android:textColor="#666680"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Thời gian -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/llTags"
            android:layout_marginTop="20dp"
            android:text="25 minute ago"
            android:textColor="#888899"
            android:textSize="12sp" />

        <!-- Mức lương -->
        <TextView
            android:id="@+id/tvSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/llTags"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:text="$15K/Mo"
            android:textColor="#1A1A2E"
            android:textSize="15sp"
            android:textStyle="bold" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
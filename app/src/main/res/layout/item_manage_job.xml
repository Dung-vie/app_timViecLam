<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/ivCompanyLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_company_placeholder"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_logo_upload"
            android:clipToOutline="true"/>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1A1A2E"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- COMPANY -->
            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#666"
                android:textSize="13sp"/>

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#888"/>

                <TextView
                    android:id="@+id/tvJobLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#777"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- SALARY -->
            <TextView
                android:id="@+id/tvJobSalary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#2D2B6B"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <!-- JOB TYPE CHIP -->
            <TextView
                android:id="@+id/tvJobType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_type"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#1976D2"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ACTIONS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="✏"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="🗑"
                android:textSize="14sp"
                app:cornerRadius="10dp"
                app:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>